# ============================================
# BINANCE API CONFIGURATION
# ============================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binancefuture.com/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_USE_TESTNET=true

# ============================================
# RISK MANAGEMENT
# ============================================
# Initial account balance in USDT
INITIAL_BALANCE=100

# Risk per trade (0.01 = 1% of account balance)
RISK_PER_TRADE=0.01

# Maximum number of open positions at once
MAX_OPEN_TRADES=3

# Leverage multiplier (1-10)
LEVERAGE=3

# ============================================
# STRATEGY PARAMETERS - TREND ANALYSIS
# ============================================
# Fast EMA period (shorter timeframe)
EMA_FAST=9

# Slow EMA period (longer timeframe)
EMA_SLOW=21

# Minimum trend strength (0.02 = 2% difference between EMAs)
MIN_TREND_STRENGTH=0.0115

# ============================================
# STRATEGY PARAMETERS - MOMENTUM
# ============================================
# RSI period (typically 14)
RSI_PERIOD=14

# RSI overbought level (70 = sell signal)
RSI_OVERBOUGHT=65

# RSI oversold level (30 = buy signal)
RSI_OVERSOLD=35

# Volume spike multiplier (1.5 = 150% of average volume)
VOLUME_SPIKE_MULTIPLIER=1.1

# ============================================
# STRATEGY PARAMETERS - PULLBACK ENTRY
# ============================================
# Maximum pullback distance from EMA (0.03 = 3%)
MAX_PULLBACK_DISTANCE=0.05

# ============================================
# STRATEGY PARAMETERS - ORDER FLOW
# ============================================
# CVD (Cumulative Volume Delta) threshold
CVD_THRESHOLD=0.3

# Minimum Open Interest change percentage
OI_CHANGE_MIN=0.0

# Require BTC correlation (true/false)
BTC_SYNC_REQUIRED=false

# ============================================
# STRATEGY PARAMETERS - RISK/REWARD
# ============================================
# Stop Loss ATR multiplier (1.5 = 1.5 * ATR)
STOP_LOSS_ATR_MULTIPLIER=3.0

# Take Profit ratio (2.5 = Risk:Reward 1:2.5)
TAKE_PROFIT_RATIO=2.0

# ============================================
# SYSTEM CONFIGURATION
# ============================================
# Database file path
DB_PATH=./data/trading.db

# Log files directory
LOG_PATH=./logs

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
