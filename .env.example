# Binance API Configuration
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true  # Сначала тестнет!

# Strategy Configuration - EMA (хорошо, оставляем)
EMA_FAST=9
EMA_SLOW=21
MIN_TREND_STRENGTH=0.01  # 1% — сильнее фильтр тренда

# Strategy Configuration - RSI (хорошо)
RSI_PERIOD=9
RSI_OVERBOUGHT=65
RSI_OVERSOLD=35

# Strategy Configuration - Volume & Momentum
VOLUME_SPIKE_MULTIPLIER=1.8  # Реальный спайк

MAX_PULLBACK_DISTANCE=0.025  # 2.5% — типичный pullback к EMA

# Strategy Configuration - Order Flow (оставляем отключенным)
CVD_THRESHOLD=0.0
OI_CHANGE_MIN=0.0

# Strategy Configuration - Risk Management
STOP_LOSS_ATR_MULTIPLIER=2.0  # Основная правка! Баланс между комнатой и размером позиции
TAKE_PROFIT_RATIO=2.0  # Ок, можно попробовать 2.5 для агрессии

# Strategy Configuration - Market Sync
BTC_SYNC_REQUIRED=false

# Risk Parameters
INITIAL_BALANCE=500  # Лучше для реального теста (с $100 позиции микроскопические)
RISK_PER_TRADE=0.01
MAX_OPEN_TRADES=2
LEVERAGE=3

# Database & Logging
DB_PATH=./data/trading.db
LOG_PATH=./logs
LOG_LEVEL=info