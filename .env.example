# ============================================
# BINANCE API CONFIGURATION
# ============================================

# ============================================
# TELEGRAM NOTIFICATIONS
# ============================================
# Get bot token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID from @userinfobot: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here
# Set to false to disable notifications (e.g., during backtests)
TELEGRAM_ENABLED=true

# ============================================
# ============================================
# Initial account balance in USDT
INITIAL_BALANCE=100

# Risk per trade (0.01 = 1% of account balance)
RISK_PER_TRADE=0.01

# Maximum number of open positions at once
MAX_OPEN_TRADES=3

# Leverage multiplier (1-10)
LEVERAGE=3

# ============================================
# STRATEGY PARAMETERS - TREND ANALYSIS
# ============================================
# Fast EMA period (shorter timeframe)
EMA_FAST=50

# Slow EMA period (longer timeframe)
EMA_SLOW=200

# ============================================
# STRATEGY PARAMETERS - MOMENTUM
# ============================================
# RSI period (typically 14)
RSI_PERIOD=14

# RSI overbought level (70 = sell signal)
RSI_OVERBOUGHT=70

# RSI oversold level (30 = buy signal)
RSI_OVERSOLD=30

# Volume spike multiplier (1.5 = 150% of average volume)
VOLUME_SPIKE_MULTIPLIER=1.8

# ============================================
# STRATEGY PARAMETERS - PULLBACK ENTRY
# ============================================
# Maximum pullback distance from EMA (0.03 = 3%)
MAX_PULLBACK_DISTANCE=0.05

# ============================================
# STRATEGY PARAMETERS - ORDER FLOW
# ============================================
# CVD (Cumulative Volume Delta) threshold
CVD_THRESHOLD=0.3


# Require BTC correlation (true/false)
BTC_SYNC_REQUIRED=false

# ============================================
# STRATEGY PARAMETERS - RISK/REWARD
# ============================================
# Stop Loss ATR multiplier (1.5 = 1.5 * ATR) - 3.0
STOP_LOSS_ATR_MULTIPLIER=2

# Take Profit ratio (2.5 = Risk:Reward 1:2.5) - 2.0
TAKE_PROFIT_RATIO=2


# ============================================
# STRATEGY PARAMETERS - ADDITIONAL
# ============================================
PULLBACK_TO_EMA=true
CHECK_LIQUIDATIONS=true
TRAILING_STOP=false
MIN_VOLUME=1000000
MAX_SPREAD=0.01

# ATR period for stop loss calculation
ATR_PERIOD=14

# Minimum Risk/Reward ratio to accept trade
MIN_RR=1.5

# Minimum signal confidence (0.0 - 1.0)
MIN_CONFIDENCE=0.6

# ============================================
# RISK MANAGEMENT - ADDITIONAL
# ============================================
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15

# ============================================
# TRADING CONFIGURATION
# ============================================
TIMEFRAME=15m
SYMBOLS=BTCUSDT,BNBUSDT,ETHUSDT,SOLUSDT,ZECUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,TRXUSDT,SUIUSDT,NEARUSDT,LINKUSDT,TAOUSDT,DOTUSDT,TONUSDT,UNIUSDT,AVAXUSDT,ATOMUSDT,RENDERUSDT,APTUSDT,OPUSDT,1000PEPEUSDT,1000LUNCUSDT
# ============================================
# SYSTEM CONFIGURATION
# ============================================
# Database file path
DB_PATH=./data/trading.db

# Log files directory
LOG_PATH=./logs

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO